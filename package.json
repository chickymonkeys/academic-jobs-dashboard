{
  "name": "academic-jobs-dashboard",
  "private": true,
  "version": "0.1.0",
  "description": "Map-first dashboard of academic vacancies in economics, political science and public policy, from EconJobMarket, AEA JOE, jobs.ac.uk, Times Higher Education, the MUR calls portal, APPAM, Academic Jobs Online, AcademicTransfer and HigherEdJobs",
  "license": "MIT",
  "author": "Alessandro Pizzigolotto",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chickymonkeys/academic-jobs-dashboard.git"
  },
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vue-tsc -p tsconfig.json",
    "preview": "vite preview",
    "typecheck": "vue-tsc -p tsconfig.json",
    "deploy:cloudflare": "void deploy --platform cloudflare",
    "ingest": "tsx scripts/ingest.ts",
    "ingest:offline": "tsx scripts/ingest.ts --offline"
  },
  "dependencies": {
    "@deck.gl/core": "^9.4.0",
    "@deck.gl/layers": "^9.4.0",
    "@deck.gl/mapbox": "^9.4.0",
    "@nuxt/ui": "^4.12.0",
    "@tanstack/vue-query": "^5.104.4",
    "@tanstack/vue-virtual": "^3.13.47",
    "@vueuse/core": "^15.0.0",
    "date-fns": "^4.4.0",
    "maplibre-gl": "^5.24.0",
    "supercluster": "^9.1.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.145",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "fast-xml-parser": "^5.11.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "void": "^1.1.11",
    "vue-tsc": "^3.3.13"
  }
}
