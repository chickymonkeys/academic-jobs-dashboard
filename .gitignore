# Dependencies
node_modules/

# Build output and tool caches
dist/
# Void: generated types/dev state and the Cloudflare config it derives from void.config.ts + void.lock.json
.void/
.void-wrangler.jsonc
.dev.vars
# Wrangler/Miniflare local state (used under the hood by Void's dev server and deploys)
.wrangler/
# Generated by Nuxt UI's auto-imports on dev/build (they embed pnpm store paths)
auto-imports.d.ts
components.d.ts
dist-ssr/
.vite/
*.tsbuildinfo
coverage/

# Ingest output and scratch: the snapshot (it holds third-party listings with contact details, and lives
# only in the deployed site), raw upstream payloads and run logs.
# data/geocache.json and data/seen.json ARE committed: they are pipeline state, with no personal data.
public/data/
data/raw/
data/*.log

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Environment
.env
.env.*
!.env.example

# Editors and OS
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
.DS_Store
Thumbs.db
